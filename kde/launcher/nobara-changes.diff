diff -ruN -x config.qml -x main.xml -x metadata.json -x Messages.sh -x CMakeLists.txt -x code upstream-6.7.4/NobaraHeadingBackground.qml local.lpnovi.kickoff/contents/ui/NobaraHeadingBackground.qml
--- upstream-6.7.4/NobaraHeadingBackground.qml
+++ local.lpnovi.kickoff/contents/ui/NobaraHeadingBackground.qml
@@ -0,0 +1,64 @@
+/*
+    Replacement band for Kickoff's header/footer PlasmoidHeading.
+
+    The theme's widgets/plasmoidheading.svg draws the band out to the popup
+    edge with ~3px outer corners, which hides the popup frame's rounder corner
+    and makes the launcher look sharp. This draws the same band (75% background
+    fill + 15% hairline on the inner edge) with outer corners that follow the
+    frame radius. The SVG background is kept (transparent) so PlasmoidHeading's
+    inset/padding logic, and therefore the layout, is unchanged.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+import QtQuick
+import org.kde.kirigami as Kirigami
+
+Item {
+    id: band
+
+    // The PlasmoidHeading this band belongs to
+    required property Item heading
+    property bool footer: false
+
+    parent: heading
+    z: -1
+    x: heading.background ? heading.background.x : 0
+    y: heading.background ? heading.background.y : 0
+    width: heading.background ? heading.background.width : 0
+    height: heading.background ? heading.background.height : 0
+
+    // Only round a corner where the popup frame itself has that corner
+    readonly property int allEdges: Qt.LeftEdge | Qt.TopEdge | Qt.RightEdge | Qt.BottomEdge
+    readonly property int windowBorders: (Window.window && Window.window.borders !== undefined)
+        ? Window.window.borders : allEdges
+    readonly property int headingBorders: heading.enabledBorders !== undefined ? heading.enabledBorders : allEdges
+    readonly property bool outerEdge: (windowBorders & (footer ? Qt.BottomEdge : Qt.TopEdge)) !== 0
+    readonly property real leftRadius: outerEdge && (windowBorders & Qt.LeftEdge) && (headingBorders & Qt.LeftEdge)
+        ? NobaraStyle.frameRadius : 0
+    readonly property real rightRadius: outerEdge && (windowBorders & Qt.RightEdge) && (headingBorders & Qt.RightEdge)
+        ? NobaraStyle.frameRadius : 0
+
+    Rectangle {
+        anchors.fill: parent
+        // The SVG was tinted by the Plasma theme's ColorScheme-Background
+        // (Nobara-Enhanced colors: 0,0,0); Kirigami.Theme here follows the app
+        // color scheme instead (#111111), which looked lighter, so pin it.
+        color: "#000000"
+        opacity: 0.75
+        antialiasing: true
+        topLeftRadius: band.footer ? 0 : band.leftRadius
+        topRightRadius: band.footer ? 0 : band.rightRadius
+        bottomLeftRadius: band.footer ? band.leftRadius : 0
+        bottomRightRadius: band.footer ? band.rightRadius : 0
+    }
+
+    // Hairline on the inner edge (bottom of the header, top of the footer)
+    Rectangle {
+        anchors.left: parent.left
+        anchors.right: parent.right
+        y: band.footer ? 0 : parent.height - height
+        height: 1
+        color: Kirigami.Theme.textColor
+        opacity: 0.15
+    }
+}
diff -ruN -x config.qml -x main.xml -x metadata.json -x Messages.sh -x CMakeLists.txt -x code upstream-6.7.4/NobaraHighlight.qml local.lpnovi.kickoff/contents/ui/NobaraHighlight.qml
--- upstream-6.7.4/NobaraHighlight.qml
+++ local.lpnovi.kickoff/contents/ui/NobaraHighlight.qml
@@ -0,0 +1,62 @@
+/*
+    Rounded purple replacement for PlasmaExtras.Highlight.
+
+    PlasmaExtras.Highlight draws widgets/viewitem, whose hover/focus colors come
+    from the Plasma theme's ButtonFocus/ViewHover entries (Breeze blue) and
+    cannot be overridden through Kirigami.Theme, so this is drawn in QML.
+
+    Same API subset as PlasmaExtras.Highlight: hovered, pressed, active.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+import QtQuick
+
+Item {
+    id: highlight
+
+    // true: the "current"/selected item; false: plain hover feedback
+    property bool hovered: true
+    property bool pressed: false
+    // false: selected item whose view does not have focus
+    property bool active: true
+    property real inset: 1
+    // sidebar categories use the slightly stronger sidebar* palette
+    property bool sidebar: false
+
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: highlight.inset
+        radius: NobaraStyle.radius
+        antialiasing: true
+
+        color: {
+            if (highlight.pressed) {
+                return NobaraStyle.pressedFill;
+            }
+            if (!highlight.hovered) {
+                return NobaraStyle.hoverFill;
+            }
+            if (highlight.sidebar) {
+                return highlight.active ? NobaraStyle.sidebarSelectedFill : NobaraStyle.sidebarInactiveFill;
+            }
+            return highlight.active ? NobaraStyle.selectedFill : NobaraStyle.inactiveFill;
+        }
+        border.width: 1
+        border.color: {
+            if (!highlight.hovered && !highlight.pressed) {
+                return "transparent";
+            }
+            if (highlight.sidebar) {
+                return highlight.active ? NobaraStyle.sidebarSelectedBorder : NobaraStyle.sidebarInactiveBorder;
+            }
+            return highlight.active ? NobaraStyle.selectedBorder : NobaraStyle.inactiveBorder;
+        }
+
+        Behavior on color {
+            ColorAnimation { duration: NobaraStyle.duration; easing.type: Easing.OutCubic }
+        }
+        Behavior on border.color {
+            ColorAnimation { duration: NobaraStyle.duration; easing.type: Easing.OutCubic }
+        }
+    }
+}
diff -ruN -x config.qml -x main.xml -x metadata.json -x Messages.sh -x CMakeLists.txt -x code upstream-6.7.4/NobaraScrollBar.qml local.lpnovi.kickoff/contents/ui/NobaraScrollBar.qml
--- upstream-6.7.4/NobaraScrollBar.qml
+++ local.lpnovi.kickoff/contents/ui/NobaraScrollBar.qml
@@ -0,0 +1,49 @@
+/*
+    Slim rounded scrollbar for the Kickoff fork.
+
+    The stock PC3.ScrollBar draws widgets/scrollbar, whose hover state uses the
+    Plasma theme's Breeze-blue highlight (KSvg ignores Kirigami.Theme
+    overrides). Metrics match the stock one under this theme (6px handle,
+    6px padding, 18px total) so the views' width math is unchanged.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+import QtQuick
+import QtQuick.Templates as T
+
+T.ScrollBar {
+    id: control
+
+    implicitWidth: implicitContentWidth + leftPadding + rightPadding
+    implicitHeight: implicitContentHeight + topPadding + bottomPadding
+
+    hoverEnabled: interactive
+    visible: policy === T.ScrollBar.AlwaysOn || (policy === T.ScrollBar.AsNeeded && size > 0 && size < 1)
+    minimumSize: horizontal ? height / width : width / height
+    padding: 6
+
+    contentItem: Rectangle {
+        implicitWidth: 6
+        implicitHeight: 6
+        radius: Math.min(width, height) / 2
+        antialiasing: true
+        color: control.pressed ? NobaraStyle.accentFocus
+            : control.hovered ? NobaraStyle.accentHover
+            : Qt.rgba(1, 1, 1, 0.22)
+
+        Behavior on color {
+            ColorAnimation { duration: NobaraStyle.duration; easing.type: Easing.OutCubic }
+        }
+    }
+
+    background: Rectangle {
+        color: Qt.rgba(1, 1, 1, 0.04)
+        radius: NobaraStyle.radius
+        opacity: control.hovered && control.interactive ? 1 : 0
+        visible: opacity > 0
+
+        Behavior on opacity {
+            NumberAnimation { duration: NobaraStyle.duration; easing.type: Easing.OutCubic }
+        }
+    }
+}
diff -ruN -x config.qml -x main.xml -x metadata.json -x Messages.sh -x CMakeLists.txt -x code upstream-6.7.4/NobaraStyle.qml local.lpnovi.kickoff/contents/ui/NobaraStyle.qml
--- upstream-6.7.4/NobaraStyle.qml
+++ local.lpnovi.kickoff/contents/ui/NobaraStyle.qml
@@ -0,0 +1,52 @@
+/*
+    Nobara Enhanced Purple palette for the local Kickoff fork.
+    Keep in sync with ~/.local/share/color-schemes/NobaraEnhancedPurple.colors
+    and the palette in ~/.local/share/nobara-enhanced-apptheme/gen_kvantum.py.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+pragma Singleton
+
+import QtQuick
+
+QtObject {
+    // Base palette
+    readonly property color accent: "#6c54aa"
+    readonly property color accentHover: "#7a63c0"
+    readonly property color accentFocus: "#8c73d2"
+    readonly property color lavender: "#b4a2f0"
