[%General]
author=lpnovi (local), based on KvSimplicityDark by Tsu Jan
comment=Nobara Enhanced Purple: near-black with muted violet accents. Derived from KvSimplicityDark (GPL-3.0-or-later).
x11drag=true
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
embedded_tabs=false
mirror_doc_tabs=false
center_doc_tabs=false
center_normal_tabs=false
joined_inactive_tabs=false
no_inactive_tab_expansion=true
bold_active_tab=false
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=3
toolbar_separator_thickness=1
spread_progressbar=true
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
menu_blur_radius=0
tooltip_blur_radius=0
reduce_menu_opacity=0
spread_menuitems=true
menu_separator_height=7
scroll_width=10
scroll_arrows=false
scroll_min_extent=48
transient_scrollbar=true
transient_groove=true
center_scrollbar_indicator=true
slider_width=4
slider_handle_width=18
slider_handle_length=18
tickless_slider_handle_size=18
center_toolbar_handle=true
check_size=16
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
reduce_window_opacity=0
popup_opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,VirtualBoxVM,trojita,dragon,digikam,lyx
vertical_spin_indicators=false
inline_spin_indicators=true
inline_spin_separator=false
fill_rubberband=true
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=false
hide_combo_checkboxes=true
square_combo_button=false
groupbox_top_label=true
remove_extra_frames=true
layout_spacing=6
layout_margin=9
submenu_overlap=0
submenu_delay=250
tooltip_delay=-1
animate_states=true
no_window_pattern=true
dialog_button_layout=0
scrollbar_in_view=true
tree_branch_line=false
splitter_width=1

[GeneralColors]
window.color=#111015
base.color=#16151c
alt.base.color=#1b1a22
button.color=#211f2a
light.color=#2f2c3b
mid.light.color=#26242f
dark.color=#0b0a0e
mid.color=#1d1b25
highlight.color=#6c54aa
inactive.highlight.color=#372f55
tooltip.base.color=#1b1a22
text.color=#dedde6
window.text.color=#dedde6
button.text.color=#dedde6
disabled.text.color=#6f6c80
tooltip.text.color=#dedde6
highlight.text.color=#ffffff
link.color=#b4a2f0
link.visited.color=#c8b8ff
progress.indicator.text.color=#ffffff
progress.inactive.indicator.text.color=#dedde6

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
transparent_pcmanfm_view=false
blur_translucent=false
transparent_menutitle=true
respect_darkness=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=60
lxqtmainmenu_iconsize=22
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
transparent_arrow_button=true
no_selection_tint=true
centered_forms=false
middle_click_scroll=false
style_vertical_toolbars=false
blur_only_active_window=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
frame.expansion=0
interior=true
interior.element=button
indicator.size=12
indicator.element=arrow
text.normal.color=#dedde6
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.shadow=0
text.margin=1
text.iconspacing=6
text.margin.top=0
text.margin.bottom=0
text.margin.left=4
text.margin.right=4

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.margin.left=2
text.margin.right=2

[ToolbarButton]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
interior.element=dock
frame.element=dock
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#dedde6

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#b9b5c9
text.focus.color=#ffffff
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
