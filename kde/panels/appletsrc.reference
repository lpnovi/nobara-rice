# Sanitized reference copy of ~/.config/plasma-org.kde.plasma.desktop-appletsrc
# (activity IDs, dialog sizes, weather location and personal paths removed).
# Not applied automatically — kde/panels/layout.js recreates the panels instead.

[ActionPlugins][0]
MiddleButton;NoModifier=org.kde.paste
RightButton;NoModifier=org.kde.contextmenu

[ActionPlugins][1]
RightButton;NoModifier=org.kde.contextmenu

[Containments][1]
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.folder
wallpaperplugin=org.kde.image

[Containments][1][Wallpaper][org.kde.image][General]
Image=file://@WALLPAPER_DIR@/desktop.jpg
SlidePaths=/usr/share/wallpapers/

[Containments][2]
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][2][Applets][5]
immutability=1
plugin=org.kde.plasma.icontasks

[Containments][2][Applets][5][Configuration][General]
iconSpacing=0
launchers=applications:systemsettings.desktop,applications:org.dnf.AppCenter.desktop,preferred://filemanager,preferred://browser,applications:discord.desktop,applications:steam.desktop,applications:io.github.kolunmi.Bazaar.desktop,applications:dev.diegovsky.Riff.desktop,applications:me.proton.Mail.desktop

[Containments][2][General]
AppletOrder=5

[Containments][31]
formfactor=2
immutability=1
lastScreen=0
location=3
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][31][Applets][32]
immutability=1
plugin=org.kde.plasma.kickoff

[Containments][31][Applets][32][Configuration][General]
favoritesPortedToKAstats=true
icon=@KICKOFF_ICON@
systemFavorites=suspend\\,hibernate\\,reboot\\,shutdown

[Containments][31][Applets][33]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][31][Applets][34]
