plugin=org.kde.plasma.digitalclock

[Containments][31][Applets][74]
immutability=1
plugin=org.kde.plasma.windowtitlereborn

[Containments][31][Applets][74][Configuration][Appearance]
customSize=27
fixedLength=438
hideWhenUnavailable=true
horizontalAlignment=0
lengthKind=1

[Containments][31][Applets][76]
immutability=1
plugin=org.kde.plasma.mediacontroller

[Containments][31][Applets][79]
immutability=1
plugin=org.kde.plasma.weather

[Containments][31][General]
AppletOrder=32;74;33;76;34;79;72

[ScreenMapping]
itemsOnDisabledScreens=
screenMapping=

# --- Panel view settings (from ~/.config/plasmashellrc) ---------------------
# Panel IDs (2, 31) are machine-specific; a new install gets new IDs.
# panelOpacity: 0 adaptive, 1 opaque, 2 translucent
# panelVisibility: 0 always visible, 1 auto-hide, 2 dodge windows, 3 windows go below
#
# [PlasmaViews][Panel 2]          # bottom dock
# floating=1
# panelLengthMode=1               # fit content
# panelOpacity=2
# panelVisibility=2
# thickness=50
#
# [PlasmaViews][Panel 31]         # top bar
# floating=0
# floatingApplets=1
# panelOpacity=2
# panelVisibility=2
# thickness=36
